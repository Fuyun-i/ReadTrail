{
  "name": "readtrail",
  "version": "0.2.0",
  "private": true,
  "description": "ReadTrail — Find what you have read. 自动记录读过的网页，本地检索，随时找回。",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "flexsearch": "^0.8.164",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
